{
  "name": "simple-inventory",
  "version": "0.6.0",
  "description": "Home Assistant Simple Inventory Integration Card",
  "author": "Blaine Venturine",
  "license": "MIT",
  "main": "dist/simple-inventory-card.js",
  "card_type": "simple-inventory-card",
  "repository": {
    "type": "git",
    "url": "https://github.com/blaineventurine/simple-inventory-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "inventory"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && vite build --config vite.panel.config.ts",
    "check-translations": "node scripts/checkTranslations.js",
    "dev": "vite",
    "format": "prettier --write './**/*.ts'",
    "format:check": "prettier --check './**/*.{js,ts}'",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "lint:staged": "eslint --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "type-check:incremental": "tsc --noEmit --incremental"
  },
  "lint-staged": {
    "./**/*.{ts,js}": [
      "bash -c 'tsc --noEmit'",
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "fast-check": "^4.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "terser": "^5.41.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "lit": "^3.3.0",
    "tslib": "^2.8.1"
  }
}
